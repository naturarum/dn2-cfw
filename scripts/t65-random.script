# T6.5: the page randomiser (hold the page's key, press YES: ParameterPageView::vslot56 ->
# FUN_4004552e -> each row's ParameterSet::vslot07, which reads the display table's randomiser).
# FLTR page, SYN page, AMP page, then the flanger page (SEND FX 3: TEST and TST2 in GT1T, whose
# randomiser param-grow clears) with FX held. Run with --state: which FX words moved.
wait-emu 0.5
tap bracketleft      # FLTR
wait-emu 0.5
png 00-fltr
down bracketleft     # FLTR held
wait-emu 0.2
tap Return           # + YES
wait-emu 0.2
up bracketleft
wait-emu 0.8
png 01-fltr-random
tap p                # SYN
wait-emu 0.5
down p
wait-emu 0.2
tap Return
wait-emu 0.2
up p
wait-emu 0.8
png 02-syn-random
tap bracketright     # AMP
wait-emu 0.5
down bracketright
wait-emu 0.2
tap Return
wait-emu 0.2
up bracketright
wait-emu 0.8
png 03-amp-random
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1
wait-emu 0.1
up space
wait-emu 0.5
tap Down
wait-emu 0.4
tap Down
wait-emu 0.5
png 04-flanger
down l               # FX held
wait-emu 0.2
tap Return           # + YES
wait-emu 0.2
up l
wait-emu 0.8
png 05-flanger-random
wait-emu 2.0
png 06-flanger-after
tap p
wait-emu 0.5
png 07-end
