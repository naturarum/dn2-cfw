# T5.0: the FX pages, from the warm 800M snapshot (main screen, track 1).
# Track FX page (FX key, CHR = chorus send on encoder G), then SEND FX 1-3 (FUNC+FX, DOWN, DOWN),
# then an encoder turn on the chorus page (value display) and the encoder-push value popup.
wait-emu 0.5
png 00-main
tap l                # FX: the track FX page (BR OVER SRR SR.RT DEL REV CHR OD.RT)
wait-emu 0.5
png 01-trackfx
tap 7                # encoder G (CHR) one detent right
wait-emu 0.4
png 02-trackfx-chr
down space           # FUNC held
wait-emu 0.1
tap l                # + FX = SEND FX 1 (delay)
wait-emu 0.1
up space
wait-emu 0.5
png 03-sendfx1-delay
tap Down
wait-emu 0.4
png 04-sendfx2-reverb
tap Down
wait-emu 0.4
png 05-sendfx3-chorus
tap 1                # encoder A (DPTH) one detent right
wait-emu 0.4
png 06-chorus-dpth
tap 2                # encoder B (SPD)
wait-emu 0.4
png 07-chorus-spd
down F1              # encoder A push held: value popup
wait-emu 0.4
png 08-chorus-pushA
up F1
wait-emu 0.4
png 09-chorus-after
