# FL02: the three compressor band pages (notes/FL02.md) from the warm 800M snapshot, as they are; run with
# --set-k for the minimum / middle / maximum pictures: scripts/fl02-emu.sh run fl02_live scripts/fl02-comp.script --set-k ...
wait-emu 0.5
down space
wait-emu 0.1
tap semicolon      # FUNC+MOD: MIXER, Compressor Low (1/7)
wait-emu 0.1
up space
wait-emu 0.8
png 01-low
tap Down
wait-emu 0.8
png 02-mid
tap Down
wait-emu 0.8
png 03-high
