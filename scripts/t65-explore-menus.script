tap Down
wait-emu 0.3
png 09-preset-6
tap Down
wait-emu 0.3
png 10-preset-7
tap Right
wait-emu 0.4
png 11-preset-right
tap Down
wait-emu 0.3
png 12-pr-1
tap Down
wait-emu 0.3
png 13-pr-2
tap Down
wait-emu 0.3
png 14-pr-3
tap Down
wait-emu 0.3
png 15-pr-4
tap Escape
wait-emu 0.3
tap Escape
wait-emu 0.3
tap Escape
wait-emu 0.3
tap grave            # SETTINGS > PROJECT
wait-emu 0.4
tap Return
wait-emu 0.4
png 16-project
tap Down
wait-emu 0.3
png 17-project-1
tap Down
wait-emu 0.3
