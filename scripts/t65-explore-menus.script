# T6.5: find the page randomiser, the PRESET/KIT menu rows, and the project menu.
wait-emu 0.3
tap bracketleft      # FLTR
wait-emu 0.4
png 00-fltr
down space
wait-emu 0.1
tap Return           # FUNC+YES on a parameter page
wait-emu 0.1
up space
wait-emu 0.6
png 01-fltr-func-yes
wait-emu 1.5
png 02-fltr-after
tap m                # PRESET
wait-emu 0.5
png 03-preset
tap Down
wait-emu 0.3
