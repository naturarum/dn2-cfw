# TE01: the Echo page (SEND FX 1) with echo-names 0.1 next to flanger-names 0.2: the page and its knobs, MODE through
# its seven values, AGE on G turned up (its value shown while it turns), CNTR and BW with the band picture; then the
# reverb page and the chorus page (Flanger, TIME on C). Run with t63b_live (the drawn texts).
wait-emu 0.5
png 00-main
down space           # FUNC held
wait-emu 0.1
tap l                # + FX: SEND FX 1, the Echo page
wait-emu 0.1
up space
wait-emu 0.8
png 01-echo
tap 2                # B MODE up: 2, 3, 12
wait-emu 0.3
tap 2
wait-emu 0.3
tap 2
wait-emu 0.3
png 02-mode-12
tap 2                # 23, 13, 123
wait-emu 0.3
tap 2
wait-emu 0.3
tap 2
wait-emu 0.3
png 03-mode-123
tap 7                # G AGE up while turning
wait-emu 0.1
tap 7
wait-emu 0.1
tap 7
wait-emu 0.1
tap 7
wait-emu 0.1
tap 7
wait-emu 0.1
png 04-age-turning
wait-emu 3.0
png 05-age-label
tap shift+5          # E CNTR down, F BW down: the band picture moves
wait-emu 0.2
tap shift+5
wait-emu 0.2
tap shift+6
wait-emu 0.2
tap shift+6
wait-emu 0.2
tap shift+6
wait-emu 0.6
png 06-band
tap Down             # the next SEND FX page: the reverb
wait-emu 0.8
png 07-reverb
tap Down             # the chorus slot: Flanger
wait-emu 0.8
png 08-flanger
