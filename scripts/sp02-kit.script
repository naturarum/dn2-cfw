# SP02: scripts/sp02-emu.sh run sp01_live SCRIPT (notes/SP02-spring-pack.md).
# MODE +6, DIRT +3, TONE -5 and WDTH +9 on A01's kit, then pattern A02 (its own kit) and A01 again
wait-emu 0.5
png 00-main
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1 (the delay)
wait-emu 0.1
up space
wait-emu 0.8
tap Down             # SEND FX 2: the spring
wait-emu 0.8
png 00-a01-spring
tap 3
wait-emu 0.3
tap 3
wait-emu 0.3
tap 3
wait-emu 0.3
tap 3
wait-emu 0.3
tap 3
wait-emu 0.3
tap 3
wait-emu 0.3
tap 4
wait-emu 0.3
tap 4
wait-emu 0.3
tap 4
wait-emu 0.3
tap shift+6
wait-emu 0.3
tap shift+6
wait-emu 0.3
tap shift+6
wait-emu 0.3
tap shift+6
wait-emu 0.3
tap shift+6
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
tap 7
wait-emu 0.3
wait-emu 3.0
png 01-a01-set
tap comma                # PTN
wait-emu 0.5
png 02-ptn-a02
tap w                # pattern A02 (the view stays on the Spring page)
wait-emu 0.8
wait-emu 3.0
png 03-a02-spring
tap comma                # PTN
wait-emu 0.5
png 04-ptn-a01
tap q                # pattern A01
wait-emu 0.8
wait-emu 3.0
png 05-a01-spring
