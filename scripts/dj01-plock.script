# DJ01: p-locks on WAVE. Grid recording on, trigs on steps 1, 2 and 3 of track 1; on the MOD page (LFO 1) WAVE
# turned from its default (FUNC + left: 1, SINE) up 8 (9, PMAJ); then trig 1 held and WAVE turned up 1, trig 2 held and WAVE up 7
# (to 15, OCTA), trig 3 held and WAVE down 2; grid recording off (the emulator drops the first detent of a turn while a trig is held: the locks came out 9, 15, 8). The locks are read from the end
# snapshot (scripts/t61_locks.py --base the warm snapshot), the screens' texts show the locked values.
wait-emu 0.5
tap semicolon        # MOD: LFO 1
wait-emu 0.5
png 00-lfo1
down space
wait-emu 0.1
tap percent
wait-emu 0.2
up space
wait-emu 0.4
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
tap 5
wait-emu 0.25
wait-emu 0.3
png 01-wave-dvt
tap 0                # RECORD: grid recording on
wait-emu 0.3
tap q
wait-emu 0.2
tap w
wait-emu 0.2
tap e
wait-emu 0.3
