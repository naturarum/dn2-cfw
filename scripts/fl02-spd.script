# FL02: FUNC + turn on the flanger's SPD (chorus page, knob B) from the warm 800M snapshot: synced values
# up to 1/32 and held there, back down, a turn without FUNC leaving the sync and coming back, FUNC + left from a
# free value (notes/T5.6-flanger-retune.md section 7). scripts/fl02-emu.sh run fl02_live scripts/fl02-spd.script
wait-emu 0.5
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1 (delay)
wait-emu 0.1
up space
wait-emu 0.5
tap Down
wait-emu 0.4
tap Down
wait-emu 0.6
png 01-chorus
tap 2                # B: SPD +1 (no FUNC)
wait-emu 0.5
png 02-spd-up
down space           # FUNC held
wait-emu 0.3
tap 2                # (the first click after FUNC goes down does nothing, as on the delay)
wait-emu 0.5
png 03-func-1
tap 2
wait-emu 0.5
png 04-func-2
tap 2
wait-emu 0.5
png 05-func-3
tap 2
wait-emu 0.5
png 06-func-4
tap 2
wait-emu 0.5
png 07-func-5
tap 2
wait-emu 0.5
png 08-func-6
tap 2
wait-emu 0.5
png 09-func-7
tap 2
wait-emu 0.5
png 10-func-8
tap 2
wait-emu 0.5
png 11-func-9
tap 2
wait-emu 0.5
png 12-func-10
tap 2
wait-emu 0.5
png 13-func-11
tap 2
wait-emu 0.5
png 14-func-12
tap 2
wait-emu 0.5
png 15-func-13
tap shift+2
wait-emu 0.5
png 16-func-down-1
tap shift+2
wait-emu 0.5
png 17-func-down-2
tap shift+2
wait-emu 0.5
png 18-func-down-3
up space             # FUNC up
wait-emu 0.4
tap 2                # SPD +1 without FUNC: leaves the sync
wait-emu 0.5
png 19-normal-up
tap shift+2          # and back: the same number, synced again
wait-emu 0.5
png 20-normal-back
tap shift+2
wait-emu 0.5
png 21-normal-down
down space
wait-emu 0.3
tap shift+2          # (the first click after FUNC goes down does nothing, as on the delay)
wait-emu 0.5
tap shift+2          # FUNC + left from a free value: the synced value below
wait-emu 0.5
png 22-func-left-from-free
up space
wait-emu 0.5
tap 3                # C: TIME +1 (the other knobs as before)
wait-emu 0.5
png 23-time-up
