# T5.3 (generated by scripts/t53_mkscripts.py; do not edit).
# grid recording, trig 1 held: FLTR A (control), then TIME, MODE, AGE, REV on the Echo page
wait-emu 0.5
tap 0                # RECORD: grid recording on
wait-emu 0.3
tap q                # a trig on step 1
wait-emu 0.3
png 00-grid
tap bracketleft                # FLTR
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 01-fltr-a-held
up q
wait-emu 0.4
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1
wait-emu 0.1
up space
wait-emu 0.8
png 02-echo
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 03-time-held
tap 2
wait-emu 0.3
png 04-mode-held
tap 7
wait-emu 0.3
png 05-age-held
tap 8
wait-emu 0.3
png 06-rev-held
up q
wait-emu 0.5
png 07-released
tap 2
wait-emu 0.4
png 08-mode-free
tap 7
wait-emu 0.4
png 09-age-free
tap 0                # RECORD off
wait-emu 0.3
wait-emu 2.0
png 10-end
