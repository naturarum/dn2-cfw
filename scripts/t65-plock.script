# T6.5: p-locks. Grid recording, trig 1 of track 1 placed, then held while knobs turn on: SYN (A),
# FLTR (A), AMP (A), track FX (E), SEND FX delay (A, H), reverb (A), flanger/chorus (A, E: TEST
# in GT1T, empty otherwise), MIXER compressor (A). Same keys on every build; the lock records are
# read from the end snapshot (scripts/t61_locks.py --base the build's warm snapshot).
wait-emu 0.5
tap 0                # RECORD: grid recording on
wait-emu 0.3
tap q                # a trig on step 1
wait-emu 0.3
png 00-grid
tap p                # SYN
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 01-syn-a
up q
wait-emu 0.4
tap bracketleft      # FLTR
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 02-fltr-a
up q
wait-emu 0.4
tap bracketright     # AMP
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 03-amp-a
up q
wait-emu 0.4
tap l                # track FX
wait-emu 0.5
down q
wait-emu 0.3
tap 5
wait-emu 0.3
png 04-fx-e
up q
wait-emu 0.4
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1
wait-emu 0.1
up space
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.2
tap 8
wait-emu 0.3
png 05-send1-a-h
up q
wait-emu 0.4
tap Down
wait-emu 0.4
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 06-send2-a
up q
wait-emu 0.4
tap Down
wait-emu 0.4
down q
wait-emu 0.3
tap 1
wait-emu 0.2
tap 5                # flanger page E: TEST in GT1T
wait-emu 0.2
tap 5
wait-emu 0.3
png 07-send3-a-e
up q
wait-emu 0.4
down space
wait-emu 0.1
tap semicolon        # FUNC+MOD: MIXER (compressor)
wait-emu 0.1
up space
wait-emu 0.5
down q
wait-emu 0.3
tap 1
wait-emu 0.3
png 08-comp-a
up q
wait-emu 0.4
tap 0                # RECORD off
wait-emu 0.4
tap p
wait-emu 0.5
png 09-end
