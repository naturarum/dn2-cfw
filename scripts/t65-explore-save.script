# T6.5: can a project be saved to the emulator's +Drive (an empty eMMC)? SAVE PROJECT AS, then the
# quick save (FUNC+YES) and reload (FUNC+NO) of the pattern and kit.
wait-emu 0.3
tap grave            # SETTINGS
wait-emu 0.4
tap Return           # PROJECT
wait-emu 0.4
tap Down             # SAVE PROJECT AS
wait-emu 0.3
tap Return
wait-emu 0.6
png 00-saveas
tap Return           # YES (accept the name)
wait-emu 1.0
png 01-after-yes
wait-emu 3.0
png 02-after-3s
tap Return
wait-emu 1.0
png 03-yes-again
wait-emu 3.0
png 04-after-6s
tap Escape
wait-emu 0.4
tap Escape
wait-emu 0.4
tap Escape
wait-emu 0.4
png 05-back
tap bracketleft      # FLTR
wait-emu 0.4
down space
wait-emu 0.1
tap Return           # FUNC+YES: save
wait-emu 0.1
up space
wait-emu 0.8
png 06-func-yes
wait-emu 2.0
png 07-func-yes-2s
tap 1                # turn FLTR A
wait-emu 0.3
tap 1
wait-emu 0.4
png 08-turned
down space
wait-emu 0.1
tap BackSpace        # FUNC+NO: reload
wait-emu 0.1
up space
wait-emu 0.8
png 09-func-no
tap Return           # confirm, if asked
wait-emu 1.0
png 10-confirm
wait-emu 2.0
png 11-after
