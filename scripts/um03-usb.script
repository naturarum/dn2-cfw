# UM03: SETTINGS > SYSTEM > USB CONFIG: the four choices, then USB MULTI/MIDI chosen with YES.
# Run with t19_live and --read-syms out/UM03/emu/read.map.json:cfg*4,mode,um_on,usbrestart,usbdelay,it5*8,as2*16,ep83*8
wait-emu 0.3
tap grave            # SETTINGS
wait-emu 0.4
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
png 00-settings-system
tap Return           # SYSTEM
wait-emu 0.5
png 01-system
tap Return           # USB CONFIG
wait-emu 0.5
png 02-usbcfg
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.3
png 03-usbcfg-row4
tap Return           # YES: USB MULTI/MIDI
wait-emu 1.0
png 04-chosen
wait-emu 1.0
png 05-later
