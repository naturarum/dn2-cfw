# BA05: the arp on a MIDI track, read on DIN MIDI out (--midi-log). Track 1 -> the MIDI machine on channel 1 (as
# out/T2.4c/proof/midi-proof.script); the ARP menu opens on it (stock: it doesn't); MODE UP, SPEED 1/32, RANGE 2.
# Live: C3 held from MIDI in for 1.2 s -> arp notes C3 C4 C3 C4 ... every 1/32. Sequenced: a trig on step 1, PLAY ->
# the trig's note through the arp (UP over two octaves at 1/32 while the 1/16 trig lasts). FUNC + ARP off, PLAY again
# -> the stock MIDI trig. Run with the audio clock (--ssi0-hz --ips 150e6): the voice interrupt and the sequencer run.
wait-emu 0.3
down space           # FUNC held
wait-emu 0.1
tap p                # + SYN = MACHINE SEL
wait-emu 0.1
up space
wait-emu 0.4
tap Down
wait-emu 0.2
tap Down             # MIDI
wait-emu 0.2
tap Return           # select it
wait-emu 0.6
tap Escape           # close the menu
wait-emu 0.4
down space           # FUNC + encoder A push: CHAN on (channel 1)
wait-emu 0.1
tap F1
wait-emu 0.1
up space
wait-emu 0.4
png 1-midi-track
tap v                # ARP: the menu, on a MIDI track
wait-emu 0.6
png 2-arp-menu
tap 1                # MODE: TRUE
wait-emu 0.2
tap 1                # UP
wait-emu 0.2
tap 2                # SPEED: 1/16 -> 1/32 (four steps)
wait-emu 0.2
tap 2
wait-emu 0.2
tap 2
wait-emu 0.2
tap 2
wait-emu 0.2
tap 3                # RANGE 2
wait-emu 0.4
png 3-arp-set
tap Escape
wait-emu 0.4
midi-in 90 30 64     # live: C3 held (channel 1)
wait-emu 1.2
midi-in 80 30 00
wait-emu 0.5
png 4-live-done
tap 0                # RECORD: grid recording
wait-emu 0.3
tap q                # a trig on step 1
wait-emu 0.3
tap 0                # grid recording off
wait-emu 0.4
png 5-trig
tap minus            # PLAY: the trig through the arp
wait-emu 2
tap equal            # STOP
wait-emu 0.6
png 6-arp-played
down space           # FUNC + ARP: the arp off
wait-emu 0.1
tap v
wait-emu 0.1
up space
wait-emu 0.4
png 7-arp-off
tap minus            # PLAY: the stock MIDI trig
wait-emu 2
tap equal            # STOP
wait-emu 0.6
png 8-stock-played
