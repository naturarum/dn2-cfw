# FL02 (notes/T5.6 7.1): how the stock delay answers FUNC + turn: the delay page (SEND FX 1), TIME (A) turned without
# and with FUNC, then FDBK (D). scripts/fl02-emu.sh run fl02_live scripts/fl02-delay.script
wait-emu 0.5
down space
wait-emu 0.1
tap l
wait-emu 0.1
up space
wait-emu 0.6
png 01-delay
tap 1
wait-emu 0.4
png 02-A-up1
tap 1
wait-emu 0.4
png 03-A-up2
down space
wait-emu 0.2
tap 1
wait-emu 0.4
png 04-func-A-up1
tap 1
wait-emu 0.4
png 05-func-A-up2
tap 1
wait-emu 0.4
png 06-func-A-up3
tap shift+1
wait-emu 0.4
png 07-func-A-down1
up space
wait-emu 0.3
tap 1
wait-emu 0.4
png 08-A-up1
down space
wait-emu 0.2
tap 4
wait-emu 0.4
png 09-func-D-up1
up space
wait-emu 0.2
tap 4
wait-emu 0.4
png 10-D-up1
