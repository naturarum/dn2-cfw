# T6.5: copy and paste. SYN page copied (FUNC+REC) and pasted onto track 2's SYN page (FUNC+STOP);
# track 1's sound copied (TRK+FUNC+REC) and pasted onto track 3 (TRK+FUNC+STOP); the flanger page
# copied and pasted after a turn of A (FUNC+PLAY clears it); then pattern A01 copied onto A03.
wait-emu 0.5
tap p                # SYN, track 1
wait-emu 0.5
down space
wait-emu 0.1
tap 0                # FUNC+REC: copy page
wait-emu 0.1
up space
wait-emu 0.6
png 00-syn-copy
down Tab
wait-emu 0.1
tap w                # TRK+TRIG 2: track 2
wait-emu 0.1
up Tab
wait-emu 0.5
png 01-track2
down space
wait-emu 0.1
tap equal            # FUNC+STOP: paste page
wait-emu 0.1
up space
wait-emu 0.6
png 02-syn-paste
down Tab
wait-emu 0.1
tap q                # track 1
wait-emu 0.1
up Tab
wait-emu 0.5
down Tab
wait-emu 0.1
down space
wait-emu 0.1
tap 0                # TRK+FUNC+REC: copy the track's sound
wait-emu 0.1
up space
wait-emu 0.1
up Tab
wait-emu 0.6
png 03-trk-copy
down Tab
wait-emu 0.1
tap e                # track 3
wait-emu 0.1
up Tab
wait-emu 0.5
down Tab
wait-emu 0.1
down space
wait-emu 0.1
tap equal            # TRK+FUNC+STOP: paste the sound
wait-emu 0.1
up space
wait-emu 0.1
up Tab
wait-emu 0.6
png 04-trk-paste
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1
wait-emu 0.1
up space
wait-emu 0.5
tap Down
wait-emu 0.4
tap Down
wait-emu 0.5
down space
wait-emu 0.1
tap 0                # copy the flanger page
wait-emu 0.1
up space
wait-emu 0.6
png 05-flanger-copy
tap 1
wait-emu 0.3
tap 1
wait-emu 0.3
down space
wait-emu 0.1
tap minus            # FUNC+PLAY: clear the page
wait-emu 0.1
up space
wait-emu 0.6
png 06-flanger-clear
down space
wait-emu 0.1
tap equal            # paste it back
wait-emu 0.1
up space
wait-emu 0.6
png 07-flanger-paste
tap p
wait-emu 0.5
down space
wait-emu 0.1
tap 0                # FUNC+REC on the main screen: copy pattern
wait-emu 0.1
up space
wait-emu 0.6
png 08-ptn-copy
tap comma
wait-emu 0.4
tap e                # A03
wait-emu 0.6
tap BackSpace
wait-emu 0.3
down space
wait-emu 0.1
tap equal            # paste pattern
wait-emu 0.1
up space
wait-emu 0.6
png 09-ptn-paste
wait-emu 1.0
png 10-end
