# MR03: scripts/mr03-emu.sh run sp01_live SCRIPT (notes/MR03-eeem.md).
# the reverb page (MRB): each knob up one and back, C (CHAR) up 8, the labels after the value pop-up
wait-emu 0.5
png 00-main
down space
wait-emu 0.1
tap l                # FUNC+FX: SEND FX 1 (the delay)
wait-emu 0.1
up space
wait-emu 0.8
tap Down             # SEND FX 2: the reverb
wait-emu 0.8
png 01-reverb
tap 1
wait-emu 0.4
png 02-A-pre-up1
tap shift+1
wait-emu 0.4
tap 2
wait-emu 0.4
png 04-B-dec-up1
tap shift+2
wait-emu 0.4
tap 3
wait-emu 0.4
png 06-C-char-up1
tap shift+3
wait-emu 0.4
tap 4
wait-emu 0.4
png 08-D-size-up1
tap shift+4
wait-emu 0.4
tap 5
wait-emu 0.4
png 10-E-hpf-up1
tap shift+5
wait-emu 0.4
tap 6
wait-emu 0.4
png 12-F-tone-up1
tap shift+6
wait-emu 0.4
tap 7
wait-emu 0.4
png 14-G-empty-up1
tap shift+7
wait-emu 0.4
tap 3
wait-emu 0.25
tap 3
wait-emu 0.25
tap 3
wait-emu 0.25
tap 3
wait-emu 0.25
wait-emu 0.3
png 20-C-char-up4
wait-emu 3.0
png 21-labels
