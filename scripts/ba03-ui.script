# BA03: the ARP menu with TM. MODE up through OFF .. RAND to TM and past it (it holds); LOOP CHANGE on E (up, down,
# held at 0); ARP LENGTH 8; notes held from MIDI in so the arp runs and the step graph moves; LOOP CHANGE 100; A down
# to RAND and up again (TM comes back with its LOOP CHANGE); FUNC + ARP off and on (TM restored). Each screen's drawn
# texts (t63b_live) show the values.
wait-emu 0.5
tap v                # ARP: the arpeggiator menu
wait-emu 0.8
png a00
tap 1
wait-emu 0.4
png a01
tap 1
wait-emu 0.4
png a02
tap 1
wait-emu 0.4
png a03
tap 1
wait-emu 0.4
png a04
tap 1
wait-emu 0.4
png a05
tap 1
wait-emu 0.4
png a06
tap 1                # TM
wait-emu 0.4
png a07
tap 1                # past TM: holds
wait-emu 0.4
png a08
tap 5                # E: LOOP CHANGE up
wait-emu 0.3
png c01
tap 5
wait-emu 0.3
tap 5
wait-emu 0.3
png c03
tap percent          # E down
wait-emu 0.3
png c02
tap percent
wait-emu 0.2
tap percent
wait-emu 0.2
tap percent
wait-emu 0.3
png c00              # held at 0
tap asterisk         # H: ARP LENGTH down from 16
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.2
tap asterisk
wait-emu 0.4
png l08
midi-in 90 30 64     # notes held on channel 1: C2, G2, C3, E3
midi-in 90 37 64
midi-in 90 3c 64
midi-in 90 40 64
wait-emu 0.5
png p01
wait-emu 0.5
png p02
wait-emu 0.5
png p03
wait-emu 0.5
png p04
tap 5                # LOOP CHANGE up a few
wait-emu 0.2
tap 5
wait-emu 0.2
tap 5
wait-emu 0.2
tap 5
wait-emu 0.5
png p05
wait-emu 0.5
png p06
tap exclam           # A down: RAND
wait-emu 0.4
png r01
tap 1                # A up: TM again, with its LOOP CHANGE
wait-emu 0.4
png r02
down space           # FUNC + ARP: the arp off
wait-emu 0.1
tap v
wait-emu 0.1
up space
wait-emu 0.4
png f01
down space           # FUNC + ARP: on again, TM restored
wait-emu 0.1
tap v
wait-emu 0.1
up space
wait-emu 0.4
png f02
midi-in 80 30 00
midi-in 80 37 00
midi-in 80 3c 00
midi-in 80 40 00
wait-emu 0.5
png p07
