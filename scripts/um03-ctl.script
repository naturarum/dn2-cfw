# UM03, control: SETTINGS > SYSTEM > USB CONFIG, YES on USB AUDIO/MIDI (stock), a cursor move, then YES on USB MULTI/MIDI.
# Run with t19_live and --read-syms out/UM03/emu/read.map.json:cfg*4,mode,um_on,usbrestart,usbdelay,it5*8,as2*16,ep83*8
wait-emu 0.3
tap grave            # SETTINGS
wait-emu 0.4
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
tap Down
wait-emu 0.2
png 00-settings-system
tap Return           # SYSTEM
wait-emu 0.5
png 01-system
tap Return           # USB CONFIG
wait-emu 0.5
png 02-usbcfg
tap Down
wait-emu 0.2
tap Down
wait-emu 0.3
png 03-row3
tap Return           # YES: USB AUDIO/MIDI (Elektron's)
wait-emu 1.0
png 04-row3-chosen
tap Up
wait-emu 0.3
png 05-up
tap Down
wait-emu 0.2
tap Down
wait-emu 0.3
png 06-row4
tap Return           # YES: USB MULTI/MIDI
wait-emu 1.0
png 07-row4-chosen
tap Up
wait-emu 0.3
png 08-up
