#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# brickcheck: refuse a candidate Digitone II OS 1.12 .syx unless every safety
# check passes. See tools/brickcheck/README.md.
#
#   tools/brickcheck/brickcheck <candidate.syx> [--stock elektron-firmware/Digitone_II_OS1_12.syx]
#                               [--intended-main <main_os.bin>] [--out DIR]
#                               [--no-emu-boot] [--no-device]
#
# Runs under digikit's uv environment (vendor/digikit/.venv, with its patched
# Unicorn). Never talks to hardware.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/../.." && pwd)
py=$root/vendor/digikit/.venv/bin/python
if [[ ! -x $py ]]; then
  echo "error: $py is missing; set up digikit first: scripts/dn2-emu-112.sh setup" >&2
  exit 2
fi
exec "$py" "$here/brickcheck.py" "$@"
